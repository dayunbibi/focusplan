# Pooled connection string, used by the app at runtime.
# Neon: copy it from the dashboard (Connect, with "Connection pooling" on), keep ?sslmode=require
# Local: postgresql://postgres:postgres@localhost:5432/focusplan
DATABASE_URL=

# Direct (unpooled) connection string, used by Prisma CLI for migrations.
# Optional locally: falls back to DATABASE_URL when empty.
DATABASE_URL_UNPOOLED=
